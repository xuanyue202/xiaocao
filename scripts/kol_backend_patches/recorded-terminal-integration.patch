+func sameRecordedRecoveryPath(originalRaw, freshRaw string) bool {
+	original, originalErr := url.Parse(originalRaw)
+	alias, aliasErr := url.Parse(freshRaw)
+	return originalErr == nil && aliasErr == nil && recordedReplayOrigin(original) && recordedReplayOrigin(alias) &&
+		original.Scheme == alias.Scheme && original.Host == alias.Host && original.Path == alias.Path &&
+		original.EscapedPath() == alias.EscapedPath() && original.User == nil && original.Fragment == "" &&
+		alias.User == nil && alias.Fragment == ""
+}
+
+func recordedRecoveryHeadersAllowed(extra any) bool {
+	value, ok := extra.(*fstream.ReqExtra)
+	return ok && value != nil && len(value.Header) == 0
+}
+
+// Durably mark the first resume before any fresh provider request. A crash or
+// failure after this point is an uncertain effect and cannot be re-prepared.
+func markRecordedRecoveryStarted(name, revision string) error {
+	f, err := os.OpenFile(name+".recorded-started", os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return fmt.Errorf("recorded recovery resume already claimed")
+	}
+	_, writeErr := f.WriteString(revision + "\n")
+	if writeErr == nil {
+		writeErr = f.Sync()
+	}
+	closeErr := f.Close()
+	if writeErr != nil || closeErr != nil {
+		return fmt.Errorf("recorded recovery resume marker failed")
+	}
+	directory, err := os.Open(filepath.Dir(name))
+	if err != nil {
+		return fmt.Errorf("recorded recovery resume directory unavailable")
+	}
+	syncErr := directory.Sync()
+	closeErr = directory.Close()
+	if syncErr != nil || closeErr != nil {
+		return fmt.Errorf("recorded recovery resume marker not durable")
+	}
+	return nil
+}
