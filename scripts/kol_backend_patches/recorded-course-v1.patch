+		case "/key.php":
+			calls.Add(1)
+			w.Write(key)
+		}
+	}))
+	defer origin.Close()
+	root := t.TempDir()
+	c, err := newReplayCache(origin.URL+"/recorded.m3u8", nil, root, "same-task")
+	if err != nil {
+		t.Fatal(err)
