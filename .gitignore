# 本地配置可能包含私有环境信息。
xiaocao.yaml

# Egg-info / build
src/xiaocao.egg-info/
build/
dist/

# CLI/报告运行产物。
# - reports/ 仍然 gitignored；要保留的报告用 `git add -f` 显式加入
# - canonical 的 backtest 产出（v3_baseline / v3_seed / v3_adaptive / xwin_*）commit，
#   用于 reproducibility 和 paper-trading replay；中间实验产物 ignore
reports/

# SQLite cache：保留在本地，不进 Git。
output/.cache/*.db
output/.cache/*-wal
output/.cache/*-shm
output/.cache/*-journal
output/.cache/
output/ .cache/

# 顶层 ad-hoc artifacts（每次 backtest 产生）
output/*.log
output/*.parquet
output/result_*.csv
output/cli_result_*.csv

# 中间实验 backtest 输出（rejected 候选 / sweep 中间步，rebuildable from cache）
