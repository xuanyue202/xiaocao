.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 本地配置可能包含私有环境信息。
xiaocao.yaml

# Egg-info / build
src/xiaocao.egg-info/
build/
dist/

# CLI/报告运行产物。
# - reports/ 仍然 gitignored；要保留的报告用 `git add -f` 显式加入
# - output/.cache/xiaocao.db 是 cross-deployment 复用的核心 cache，commit
# - canonical 的 backtest 产出（v3_baseline / v3_seed / v3_adaptive / xwin_*）commit，
#   用于 reproducibility 和 paper-trading replay；中间实验产物 ignore
reports/

# SQLite cache：commit only the main .db; ignore WAL / SHM / journal
output/.cache/*-wal
output/.cache/*-shm
output/.cache/*-journal

# 顶层 ad-hoc artifacts（每次 backtest 产生）
output/*.log
output/result_*.csv
output/cli_result_*.csv

# 中间实验 backtest 输出（rejected 候选 / sweep 中间步，rebuildable from cache）
output/xiaocao_5month_seed/
output/xiaocao_8month_seed/
output/xiaocao_8mo_v3_4/
output/xiaocao_8mo_v3_5/
output/xiaocao_8mo_v3_6/
output/xiaocao_8mo_v3_dd3/
output/xiaocao_8mo_v3_dd5/
output/xiaocao_8mo_v3_hold2/
output/xiaocao_8mo_v3_hold3/
output/xiaocao_xwin_v6/
output/validation_*/
output/xiaocao_backtest_*/
output/v3_*_validate/
output/tune_*/
output/winners_losers_analysis/

# Live trading runtime — 只保 positions.jsonl.example 模板
output/live/positions.jsonl
output/live/alerts.jsonl
output/live/recommend_*.md
output/live/*.log

# Paper trading runtime（每次 replay 重新生成）
output/paper_v6/
